<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OpenFile" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme for MainActivity; installSplashScreen() swaps in Theme.OpenFile once the first frame is ready. -->
    <style name="Theme.OpenFile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/manila</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenFile</item>
    </style>
</resources>
